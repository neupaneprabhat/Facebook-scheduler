# Database (SQLite for easy zero-setup local dev, or PostgreSQL: postgresql://user:pass@localhost:5432/fb_scheduler)
DATABASE_URL="file:./dev.db"

# Redis Queue (Optional for BullMQ production mode)
REDIS_URL="redis://127.0.0.1:6379"

# Application URL
APP_URL="http://localhost:3000"

# Meta / Facebook App Credentials (leave empty or fill for live Meta Graph API)
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_REDIRECT_URI="http://localhost:3000/api/facebook/auth"
FACEBOOK_GRAPH_API_VERSION="v21.0"

# AES-256 Secret Encryption Key for Facebook Page Access Tokens (32 bytes hex or string)
TOKEN_ENCRYPTION_KEY="fbc9e7a884d632f05a9681bc13e01a89c8369ffb19b780bc1a8f9024c088ef31"

# Developer Login Credentials (Restricted Access)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123456"
